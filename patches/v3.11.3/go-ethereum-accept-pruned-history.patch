+package core
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// TestOpenCustomPrunedHistory checks that a database whose ancient tail was
+// truncated offline to an arbitrary block opens in the default history mode,
+// and that the tail becomes the history pruning cutoff.
+func TestOpenCustomPrunedHistory(t *testing.T) {
+	var (
+		key, _  = crypto.HexToECDSA("b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291")
+		address = crypto.PubkeyToAddress(key.PublicKey)
+		gspec   = &Genesis{
+			Config:  params.TestChainConfig,
+			Alloc:   types.GenesisAlloc{address: {Balance: big.NewInt(1e18)}},
+			BaseFee: big.NewInt(params.InitialBaseFee),
+		}
+		signer = types.LatestSigner(gspec.Config)
+		engine = beacon.New(ethash.NewFaker())
+	)
+	_, blocks, receipts := GenerateChainWithGenesis(gspec, engine, 64, func(i int, b *BlockGen) {
+		b.SetCoinbase(common.Address{1})
+		tx, _ := types.SignTx(types.NewTransaction(b.TxNonce(address), common.Address{2}, big.NewInt(1000), params.TxGas, b.header.BaseFee, nil), signer, key)
+		b.AddTx(tx)
+	})
+	db, _ := rawdb.Open(rawdb.NewMemoryDatabase(), rawdb.OpenOptions{})
+	defer db.Close()
+
+	chain, err := NewBlockChain(db, nil, gspec, engine, DefaultConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := chain.InsertReceiptChain(blocks, types.EncodeBlockReceiptLists(receipts), 60); err != nil {
+		t.Fatal(err)
+	}
+	chain.Stop()
+
+	const tail = 33
+	if _, err := db.TruncateTail(tail); err != nil {
+		t.Fatal(err)
+	}
+	chain, err = NewBlockChain(db, nil, gspec, engine, DefaultConfig())
+	if err != nil {
+		t.Fatalf("reopening a custom-pruned database failed: %v", err)
+	}
+	defer chain.Stop()
+
+	cutoff, hash := chain.HistoryPruningCutoff()
+	if cutoff != tail || hash != blocks[tail-1].Hash() {
+		t.Fatalf("cutoff %d %x, want %d %x", cutoff, hash, tail, blocks[tail-1].Hash())
+	}
+	if chain.GetBody(blocks[tail-2].Hash()) != nil {
+		t.Fatal("body below the cutoff should be gone")
+	}
+	if chain.GetBody(blocks[tail-1].Hash()) == nil {
+		t.Fatal("body at the cutoff should be present")
+	}
+}
